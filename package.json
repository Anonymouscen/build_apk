{
  "name": "special_zone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "electron_build": "electron-packager ./dist/ --platform=win32 --arch=x64 --icon=./dist/favicon.ico --overwrite",
    "android_sync": "npm run build && npx cap sync android",
    "android_build": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "axios": "1.5.0",
    "core-js": "^3.6.5",
    "swiper": "^5.4.5",
    "vue": "^2.6.11",
    "vue-awesome-swiper": "^4.1.1",
    "vue-router": "^3.2.0",
    "vuex": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-router": "~4.5.0",
    "@vue/cli-plugin-vuex": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "amfe-flexible": "2.2.1",
    "autoprefixer": "8.0.0",
    "babel-eslint": "^10.1.0",
    "electron": "^13.2.2",
    "electron-packager": "^15.3.0",
    "postcss-pxtorem": "5.1.1",
    "sass": "^1.26.5",
    "sass-loader": "^8.0.2",
    "vue-template-compiler": "^2.6.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "electronPackagerConfig": {
    "packageManager": "npm",
    "icon": "dist/logo.ico"
  },
  "build": {
    "appId": "com.baidu.www",
    "win": {
      "icon": "./dist/logo.ico"
    }
  }
}
